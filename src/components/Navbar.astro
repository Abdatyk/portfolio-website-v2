<style>
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background-color: #333;
}

.navbar a {
  color: #333;
  text-decoration: none;
  padding: 10px 20px;
  transition: background-color 0.3s ease, color 0.3s ease, border-radius 0.3s ease; /* Add transition for border-radius */
  border-radius: 5px; /* Add rounded corners */
}

.navbar a:hover {
  background-color: #f4f4f4;
  color: #555;
}

@media (max-width: 768px) {
  .navbar a {
    display: none;
  }
  .navbar a.active {
    display: block;
  }
}

.title {
  color: white;
  font-size: 1.5rem;
}

.categories {
  list-style-type: none;
  display: flex;
}

.categories li {
  margin-left: 20px;
}

.categories a {
  color: white;
  text-decoration: none;
  font-size: 1rem;
}

.categories a:hover {
  text-decoration: underline;
}
</style>
